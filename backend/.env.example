# CHW Care Platform — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.

# ── Application ──────────────────────────────────────────────────────────────
ENVIRONMENT=development
PROJECT_NAME="CHW Care Platform"

# ── Database ─────────────────────────────────────────────────────────────────
POSTGRES_USER=chw_app
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=chw_care_db
# Or use a full URL (overrides individual vars):
# DATABASE_URL=postgresql://chw_app:password@localhost:5432/chw_care_db

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET=CHANGE_ME_USE_OPENSSL_RAND_32_BYTES
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRE_MINUTES=30
JWT_REFRESH_EXPIRE_DAYS=7

# ── Session ───────────────────────────────────────────────────────────────────
SESSION_IDLE_MINUTES=60
SESSION_ABSOLUTE_HOURS=12

# ── CORS (comma-separated origins for production) ────────────────────────────
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# ── Rate limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=60
AUTH_RATE_LIMIT_PER_MINUTE=10

# ── Account lockout ───────────────────────────────────────────────────────────
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15

# ── Demo mode (set to false in production) ────────────────────────────────────
DEMO_MODE=true

# ── Google Gemini AI ─────────────────────────────────────────────────────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ── Password reset ────────────────────────────────────────────────────────────
PASSWORD_RESET_EXPIRE_MINUTES=60

